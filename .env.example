API_KEY=sk-xxxxxxxxxx # 请自行申请
API_BASE_URL=http://***.***.***.***:**** # 上游代理的公网出口，代理再转发到真正的上游服务
# 可选：AI 链路自检探测 /ping 用的地址。留空则跟随 API_BASE_URL，通常无需配置；
# 只有「代理与上游分开部署」时才需要单独填。
# AI_EDGE_BASE_URL=
TARGET_API_URL=http://***.***.***.***:***** # 如需使用请找EndlessPixel(system_mini)要源地址
GH_TOKEN=ghp_xxxxxxxxxxx # 请自行申请
GH_CLIENT_ID=Ovxxxxxxxxxxxxxxxx # GitHub OAuth App 客户端 ID
GH_CLIENT_SECRETS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # GitHub OAuth App 客户端密钥
NEXT_PUBLIC_SITE_URL=https://www.endlesspixel.cn # 站点域名，用于拼接 GitHub 回调地址
RANKINGS_API_BASE_URL=http://***.***.***.***:**** # 模型排行数据源（走上游代理的公网出口，代理白名单需放行 /api/rankings）
