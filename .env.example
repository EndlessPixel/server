# ============================================================================
# EndlessPixel 站点环境变量 —— 示例模板
# 复制为 .env.local 后填写；分组顺序即功能模块，新增变量请归入对应分组
# ============================================================================

# ---------- 上游代理（AI 对话 / 模型列表 / 链路自检 / 模型排行 共用） ----------
# 上游 API 密钥
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 代理的公网出口，代理再转发到真正的上游（直连上游会被 Cloudflare 拦）
# 对话、模型列表、链路自检、模型排行都是这台机器上的不同路径，共用一个地址即可
# 代理白名单需放行：/v1/models、/v1/chat/completions、/ping、/api/rankings
API_BASE_URL=http://***.***.***.***:****

# ---------- 站点与登录态 ----------
# 站点域名：拼接 GitHub 回调地址、登录后跳转
NEXT_PUBLIC_SITE_URL=https://www.endlesspixel.cn
# 会话签名密钥（HMAC-SHA256，至少 16 位）；生产环境必须配置，否则登录态可被伪造
SESSION_SECRET=

# ---------- 账号登录 ----------
# 登录后端直连地址（浏览器直接请求，后端需开放 CORS）
NEXT_PUBLIC_AUTH_API_BASE_URL=https://login-and-data.epmc.qzz.io
# 登录凭据签名密钥，必须与源站 AuthLoginAPI 的 .auth_secret 完全一致
AUTH_TOKEN_SECRET=

# ---------- GitHub ----------
# OAuth 登录用
GH_CLIENT_ID=xxxxxxxxxxxxxxxxxx
GH_CLIENT_SECRETS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 仅用于提高 GitHub API 限额（Releases / Issues），与登录无关
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：GitHub OAuth App 回调地址需配置为 {NEXT_PUBLIC_SITE_URL}/api/auth/github/callback

# ---------- 服务器状态监控 ----------
# 宿主机硬件监控的上游；网站通过 /systemstatus/data 代理它
# 走 Cloudflare 代理，注意只监听 http（https 会超时），也无需带端口
TARGET_API_URL=http://sys.epmc.qzz.io
